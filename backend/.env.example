# ─── Copy this file to .env and fill in your values ─────────────────────────
# cp .env.example .env

# JWT Secret — change this to a long random string in production
SECRET_KEY=change_me_to_a_long_random_secret_string

# Database — SQLite (default dev) or PostgreSQL (production)
DATABASE_URL=sqlite:///./biometric_app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/biosync_db

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
